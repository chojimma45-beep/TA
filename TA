-- 3. ลดความกระตุก/แล็ค & เพิ่ม FPS
Tabs.Main:AddButton({
    Title = "ลดความกระตุก & เพิ่ม FPS (Boost FPS)",
    Description = "ลบเอฟเฟกต์/ลดรายละเอียดกราฟิกเพื่อเพิ่มความลื่น",
    Callback = function()
        for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.Plastic
                v.Reflectance = 0
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v:Destroy()
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                v.Enabled = false
            end
        end
        game:GetService("Lighting").GlobalShadows = false
        Fluent:Notify({ Title = "56 SCRIPT", Content = "เพิ่ม FPS เรียบร้อยแล้ว!", Duration = 3 })
    end
})

-- 4. มองชื่อ (ESP Name) + เลือกสี 3 สี
local function UpdateESP()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
            local head = plr.Character.Head
            local bb = head:FindFirstChild("ESP_NameTag")
            
            if ESPEnabled then
                if not bb then
                    bb = Instance.new("BillboardGui")
                    bb.Name = "ESP_NameTag"
                    bb.AlwaysOnTop = true
                    bb.Size = UDim2.new(0, 100, 0, 30)
                    bb.StudsOffset = Vector3.new(0, 3, 0)
                    
                    local label = Instance.new("TextLabel")
                    label.Name = "Label"
                    label.Parent = bb
                    label.BackgroundTransparency = 1
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.Font = Enum.Font.GothamBold
                    label.TextSize = 14
                    label.TextStrokeTransparency = 0.5
                    bb.Parent = head
                end
                
                bb.Label.Text = plr.Name
                bb.Label.TextColor3 = ESPColor
            else
                if bb then bb:Destroy() end
            end
        end
    end
end

Tabs.Main:AddToggle("ESPToggle", {
    Title = "เปิดระบบมองชื่อ (ESP Name)",
    Default = false,
    Callback = function(Value)
        ESPEnabled = Value
        if not Value then
            for _, plr in pairs(Players:GetPlayers()) do
                if plr.Character and plr.Character:FindFirstChild("Head") and plr.Character.Head:FindFirstChild("ESP_NameTag") then
                    plr.Character.Head.ESP_NameTag:Destroy()
                end
            end
        end
    end
})

Tabs.Main:AddDropdown("ESPColorDropdown", {
    Title = "เลือกสี ESP (3 สี)",
    Values = {"สีแดง (Red)", "สีน้ำเงิน (Blue)", "สีขาว (White)"},
    Default = "สีแดง (Red)",
    Callback = function(Value)
        if Value == "สีแดง (Red)" then
            ESPColor = Color3.fromRGB(255, 0, 0)
        elseif Value == "สีน้ำเงิน (Blue)" then
            ESPColor = Color3.fromRGB(0, 100, 255)
        elseif Value == "สีขาว (White)" then
            ESPColor = Color3.fromRGB(255, 255, 255)
        end
    end
})

RunService.RenderStepped:Connect(function()
    if ESPEnabled then UpdateESP() end
end)

